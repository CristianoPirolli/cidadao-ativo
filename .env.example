# ─────────────────────────────────────────────────────────────────────────
#  Cidadão Ativo — variáveis de ambiente
#  Copie para .env e ajuste os valores:  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────

# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_LOG_LEVEL=INFO
# Ative quando a aplicação estiver atrás de HTTPS
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_COOKIES=false

# PostgreSQL (usado pelo Django e pelo container do banco)
POSTGRES_DB=cidadao_ativo
POSTGRES_USER=cidadao_ativo
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Porta pública do Nginx no Docker
APP_PORT=8000

# E-mail (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-de-app
DEFAULT_FROM_EMAIL=noreply@cidadaoativo.com

# Regras de negócio
URGENCY_VOTE_MAX_DISTANCE_METERS=200
PLATFORM_OWNER_EMAIL=owner@cidadaoativo.com
DEMO_PUBLIC_URL=

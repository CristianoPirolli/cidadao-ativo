# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development  # development, production, testing
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
DB_NAME=cidadao_ativo
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=localhost
DB_PORT=3306
SQLALCHEMY_DATABASE_URI=mysql+pymysql://root:your-password@localhost:3306/cidadao_ativo

# Redis (opcional - para rate limiting em produção)
# REDIS_URL=redis://localhost:6379/0

# Upload Configuration (opcional)
# MAX_CONTENT_LENGTH=10485760  # 10MB em bytes

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@cidadaoativo.com

# Security (produção)
# SESSION_COOKIE_SECURE=True
# SESSION_COOKIE_HTTPONLY=True
# SESSION_COOKIE_SAMESITE=Lax

# Django Configuration
SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=true  # true em desenvolvimento, false em produção

# Database Configuration (PostgreSQL)
DB_NAME=cidadao_ativo
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@cidadaoativo.com

# Votação de urgência (distância máxima do ponto do chamado, em metros)
URGENCY_VOTE_MAX_DISTANCE_METERS=200

# Dono da plataforma (SaaS)
PLATFORM_OWNER_EMAIL=owner@cidadaoativo.com

# Hosts permitidos (separados por vírgula)
ALLOWED_HOSTS=localhost,127.0.0.1
